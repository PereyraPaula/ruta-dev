---
import Footer from "../../components/Footer.astro";
import ListPosts from "../../components/ListPosts.astro";
import Navbar from "../../components/Navbar.astro";
import Principal from "../../layouts/Principal.astro";

import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  // Recolecta todos los tags únicos
  const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts
        .filter((post) => (post.data.tags ?? []).includes(tag))
        .sort(
          (a, b) =>
            new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
        ),
      tag,
    },
  }));
}

const { posts, tag } = Astro.props;
---

<Principal>
  <Navbar />
  <main class="mx-auto container mb-10 mt-30">
    <header class="mb-5">
      <p class="text-sm text-primary/60">Publicaciones etiquetadas con</p>
      <h1 class="text-3xl font-bold text-primary">#{tag}</h1>
      <p class="text-sm text-primary/60 mt-1">
        {posts.length}
        {posts.length === 1 ? " publicación" : " publicaciones"}
      </p>
    </header>

    <section class="my-10">
      <ListPosts posts={posts} isHorizontal={true} />
    </section>

    <Footer />
  </main>
</Principal>
